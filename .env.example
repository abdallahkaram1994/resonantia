# Copy to .env and fill in. .env is gitignored; never commit real values.
# Provider keys (TMDB, Gemini, ...) are added here by the milestone that first uses them.

# --- Django ---
# Generate one, e.g.: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=false
# Comma-separated hostnames Django will serve (no ports)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Postgres ---
POSTGRES_DB=resonantia
POSTGRES_USER=resonantia
POSTGRES_PASSWORD=change-me
# Host-side settings for tools run outside Docker (pytest, psql). Compose publishes db on
# 127.0.0.1:POSTGRES_PORT; change the port if you already run Postgres locally. Containers
# always use db:5432 regardless of these two.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Seconds to wait for a DB connection before the health check reports it down
POSTGRES_CONNECT_TIMEOUT=5

# --- Embeddings (Gemini) ---
# Free-tier key from Google AI Studio. Keep the project free of any billing account.
GEMINI_API_KEY=change-me
EMBEDDING_MODEL=gemini-embedding-2
# Must match the Item.embedding column width (768). Changing it needs a migration and a re-embed.
EMBEDDING_DIM=768
# Your free-tier requests-per-minute limit from https://aistudio.google.com/rate-limit, minus headroom
EMBEDDING_REQUESTS_PER_MINUTE=30

# --- Web server ---
# gunicorn worker count; keep low for the 2 GB VPS
WEB_CONCURRENCY=2
