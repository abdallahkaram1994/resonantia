# Copy to .env and fill in. .env is gitignored; never commit real values.
# Provider keys (TMDB, Gemini, ...) are added here by the milestone that first uses them.

# --- Django ---
# Generate one, e.g.: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=false
# Comma-separated hostnames Django will serve (no ports)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Postgres ---
POSTGRES_DB=resonantia
POSTGRES_USER=resonantia
# Use letters and digits only (for example `openssl rand -hex 24`), on one unquoted line. Docker
# Compose and `uv run --env-file` parse special characters ($, #, quotes, backslashes) differently,
# and the database keeps the password it was first created with: after changing it, run
# `docker compose down -v` to recreate the database.
POSTGRES_PASSWORD=change-me
# Host-side settings for tools run outside Docker (pytest, psql). Compose publishes db on
# 127.0.0.1:POSTGRES_PORT; change the port if you already run Postgres locally. Containers
# always use db:5432 regardless of these two.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Seconds to wait for a DB connection before the health check reports it down
POSTGRES_CONNECT_TIMEOUT=5

# --- Embeddings (Gemini) ---
# Free-tier key from Google AI Studio. Keep the project free of any billing account.
GEMINI_API_KEY=change-me
EMBEDDING_MODEL=gemini-embedding-2
# Must match the Item.embedding column width (768). Changing it needs a migration and a re-embed.
EMBEDDING_DIM=768
# Requests per minute to send. Each text is one request. Observed free-tier limits for
# gemini-embedding-2 (Sept 2026, see https://aistudio.google.com/rate-limit): 100 requests per
# minute, 30K tokens per minute, and 1,000 requests per DAY (resets at midnight Pacific time).
# The daily limit is the one that matters: about 1,000 films embedded per day, and every search
# query uses one request too. 60 leaves headroom under the per-minute limits.
EMBEDDING_REQUESTS_PER_MINUTE=60

# --- Search ---
# Results in a single-type list and in a blended list
SEARCH_RESULT_LIMIT=15
# Results per type when a query names a type and the results are grouped
SEARCH_GROUP_LIMIT=10
# Candidates fetched per media type before the layout picks what to show (at least the two above)
SEARCH_CANDIDATES_PER_TYPE=50
# In a blended list, the slots each media type with matches is guaranteed, so no type crowds out
# the rest (0 turns it off)
SEARCH_BLEND_MIN_SLOTS=2

# --- Item detail page ---
# Total items "more like this" returns (one pgvector query across every media type, then grouped)
ITEM_SIMILAR_LIMIT=12
# Longer queries are rejected with a 400, never truncated
SEARCH_MAX_QUERY_LENGTH=200

# --- Film catalog (TMDB) ---
# Use the "API Read Access Token" from your TMDB account's API settings (not the short API key).
# TMDB data is for non-commercial use, must be attributed, and must be refreshed within 6 months.
TMDB_READ_ACCESS_TOKEN=change-me
# Stay well under TMDB's roughly 40 requests per second guidance
TMDB_REQUESTS_PER_SECOND=20
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p/w342
# ingest_films warns when catalog data is older than this (TMDB's limit is 6 months)
TMDB_MAX_CACHE_DAYS=150
# Films need this many TMDB votes to count as popular...
FILM_MIN_VOTE_COUNT=1000
# ...and a band just below it (from this many votes) feeds the mid-tail slice
FILM_MID_TAIL_MIN_VOTE_COUNT=200

# --- Game catalog (IGDB) ---
# Register an app at https://dev.twitch.tv/console (Confidential client, redirect http://localhost).
# IGDB is free for non-commercial use under the Twitch Developer Services Agreement.
TWITCH_CLIENT_ID=change-me
TWITCH_CLIENT_SECRET=change-me
# IGDB allows 4 requests per second
IGDB_REQUESTS_PER_SECOND=3
IGDB_COVER_SIZE=t_cover_big
# A game needs this many ratings to count as popular (about 2,100 main games qualify)...
GAME_MIN_RATING_COUNT=75
# ...and the band below it, from this many ratings, feeds the mid-tail slice
GAME_MID_TAIL_MIN_RATING_COUNT=25
# IGDB keywords are noisy user tags (some games have 200), so only this many go into the text
GAME_MAX_KEYWORDS=10

# --- Album catalog (Last.fm, MusicBrainz, Cover Art Archive, Wikipedia) ---
# Free Last.fm API key from https://www.last.fm/api/account/create (non-commercial use only).
LASTFM_API_KEY=change-me
LASTFM_REQUESTS_PER_SECOND=2
# An email address or a URL. It goes into the User-Agent that MusicBrainz and Wikimedia require.
# Your repository URL works and keeps a personal address out of it.
CONTACT_EMAIL=change-me@example.com
# MusicBrainz allows about one request per second; going faster gets you blocked (minimum 1.0)
MUSICBRAINZ_MIN_INTERVAL_SECONDS=1.1
WIKIMEDIA_REQUESTS_PER_SECOND=1
COVERART_REQUESTS_PER_SECOND=4
# Last.fm listeners an album needs to count as popular, and the band below it for the mid-tail
ALBUM_MIN_LISTENERS=50000
ALBUM_MID_TAIL_MIN_LISTENERS=10000
# The mid-tail band only appears deep in Last.fm's lists (page 1 median: ~1,000,000 listeners;
# page 8: ~80,000; page 30: ~36,000), so that search starts on this page, and gives up after
# checking this many albums
ALBUM_MID_TAIL_START_PAGE=20
ALBUM_MID_TAIL_MAX_SCAN=1000
# Most tags per album that go into the embedding text
ALBUM_MAX_TAGS=10
# Cover Art Archive thumbnail size: 250, 500 or 1200
ALBUM_COVER_SIZE=500
# Albums whose Wikipedia intros are fetched per request (at most 20)
ALBUM_BATCH_SIZE=20

# --- Catalog (all media types) ---
# Share of each ingest taken from the mid-tail band (0 to 100), so results can surprise
MID_TAIL_PERCENT=10
CATALOG_TARGET_PER_TYPE=2000
# Cap for sample runs, for example 50. 0 means use CATALOG_TARGET_PER_TYPE.
INGEST_LIMIT=0

# --- Worker and logging ---
# The `worker` service loads this whole file (ingest jobs need the TMDB, IGDB and Last.fm keys);
# `web` only gets the variables listed for it in compose.yaml.
# Jobs the worker runs at the same time. Keep it low on the 2 GB server.
WORKER_CONCURRENCY=2
# DEBUG, INFO, WARNING, ERROR or CRITICAL
LOG_LEVEL=INFO

# --- Web server ---
# gunicorn worker count; keep low for the 2 GB VPS
WEB_CONCURRENCY=2
